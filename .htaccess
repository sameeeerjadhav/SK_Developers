# Sai Kuber Developers — Finance ERP
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Prefer HTTPS on Hostinger (optional — uncomment if SSL is active)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Block sensitive paths
RedirectMatch 403 (?i)^/(sql|config|includes)/

# Cache static assets (faster repeat visits)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|jpe?g|webp|gif|ico|svg|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
